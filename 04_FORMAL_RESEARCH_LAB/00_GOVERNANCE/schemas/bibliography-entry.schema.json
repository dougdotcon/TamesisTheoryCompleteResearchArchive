{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tamesis-bibliography-entry/1",
  "type": "object",
  "required": ["bibliography_id", "title", "source", "source_type", "used_for", "verified_at"],
  "properties": {
    "bibliography_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "used_for": {"type": "array", "items": {"type": "string"}},
    "verified_at": {"type": "string", "minLength": 10}
  },
  "additionalProperties": true
}
