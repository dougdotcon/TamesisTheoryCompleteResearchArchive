beta(gamma)        = gamma*(2 - gamma)/2
kappa_0(gamma)      = -8/(gamma*(gamma - 2))
lambda(gamma)       = 4*(2*gamma - 3)/(gamma*(gamma - 2))   (continuation front, Estagio 36; UNBOUNDED as gamma->0)
hat-lambda(gamma)   = 8*(4*gamma - 7)/(gamma*(gamma - 2))   (continuation front Step 3; growth rate of the EXPLICIT hat-G)

C0_Hoeffding(gamma)^2  = 1/4 + hat-lambda/2          = (gamma**2 + 62*gamma - 112)/(4*gamma*(gamma - 2))
C0_Bernstein(gamma,a)^2 = (2+a)*sigma^2*(hat-lambda+1/2) = -(a + 2)*(gamma - 1)*(gamma*(gamma - 2) + 64*gamma - 112)/(2*gamma - 4)

