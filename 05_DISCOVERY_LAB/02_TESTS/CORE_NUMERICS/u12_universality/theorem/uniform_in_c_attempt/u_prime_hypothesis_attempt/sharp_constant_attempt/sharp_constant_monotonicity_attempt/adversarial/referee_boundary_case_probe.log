   n=      10: loss =      0.13042   (sqrt(pi)/4)/sqrt(n) =      0.14012   loss<=cap: True
   n=     100: loss =     0.043982   (sqrt(pi)/4)/sqrt(n) =     0.044311   loss<=cap: True
   n=   10000: loss =    0.0044308   (sqrt(pi)/4)/sqrt(n) =    0.0044311   loss<=cap: True
   n= 1000000: loss =   0.00044311   (sqrt(pi)/4)/sqrt(n) =   0.00044311   loss<=cap: True
