==============================================================================
PART D -- symbolic simplification of lim_plus, lim_minus as closed
forms in gamma (not just numeric samples)
==============================================================================
lim_plus(gamma)  simplified = 4*(-gamma**2 + 2*gamma - 1)/(gamma*(gamma - 2))
lim_minus(gamma) simplified = -4

lim_plus / lambda_true  = (-gamma**2 + 2*gamma - 1)/(2*gamma - 3)
lim_minus / lambda_true = gamma*(2 - gamma)/(2*gamma - 3)
