--- L1: d/dc phi(n,c) = E_{J~Bin(n-1,c/n)}[phi_n^(J+1) - phi_n^(J)] ---
  n=2 : LHS-RHS simplifies to 0
  n=3 : LHS-RHS simplifies to 0
  n=4 : LHS-RHS simplifies to 0
  n=5 : LHS-RHS simplifies to 0
  n=6 : LHS-RHS simplifies to 0
  n=7 : LHS-RHS simplifies to 0
  n=8 : LHS-RHS simplifies to 0

--- L2: Lipschitz.  sup_c |d/dc phi(n,c)| on [0,n]  (exact endpoints) ---
      n   |phi'(n,0)|        max_J[phi_n^(J)-phi_n^(J+1)]   <= 1 ?
      2   1/4                1/4                          True
      4   5/16               5/16                         True
      8   21/64              21/64                        True
      16  85/256             85/256                       True
      32  341/1024           341/1024                     True
      64  1365/4096          1365/4096                    True
    (phi'(n,0) = phi_n^(1) - phi_n^(0) = -1/3 + 1/(3n^2) exactly,
     matching phi_inf'(0) = -1/3;  and every increment is <= 1,
     so |phi(n,c)-phi(n,c')| <= |c-c'| -- SS3's Lemma 3.2.)

