term_0(n,gamma) = (1 - (1 - gamma)**(n + 1))/gamma
term_1(n,gamma) = -(1 - gamma)**n - (1 - gamma)**(n - 1) + 2*(1 - gamma)**(n - 1)/n + (1 - gamma)**(n - 1)/gamma + 1/gamma - 4*(1 - gamma)**(n - 1)/(gamma*n) + 2/(gamma*n) + 2*(1 - gamma)**(n - 1)/(gamma**2*n) - 2/(gamma**2*n)

