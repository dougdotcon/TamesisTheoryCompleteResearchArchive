========================================================================
  symbolic-(K,r) integral minus unified form simplifies to: (-1)**K*x**r*(x - 1)**(K - 1)*(-K*x*factorial(K)*factorial(r - 1)*gamma(r)*hyper((r, -K + r), (r + 1,), 1)/gamma(r + 1) + K*x*factorial(K - r)*factorial(r - 1)**2 + K*factorial(K)*factorial(r - 1)*gamma(r)*hyper((r, -K + r), (r + 1,), 1)/gamma(r + 1) - K*factorial(K)*factorial(r - 1)*gamma(r)*hyper((r, -K + r + 1), (r + 1,), 1)/gamma(r + 1) + x*factorial(K)*factorial(r)*gamma(r)*hyper((r, -K + r), (r + 1,), 1)/gamma(r + 1) - x*factorial(r)*factorial(K - r)*factorial(r - 1) - factorial(K)*factorial(r)*gamma(r)*hyper((r, -K + r), (r + 1,), 1)/gamma(r + 1) + factorial(K)*factorial(r)*gamma(r)*hyper((r, -K + r + 1), (r + 1,), 1)/gamma(r + 1) + factorial(r)*factorial(K - r)*factorial(r - 1))*binomial(K, r)/(factorial(K - r)*factorial(r - 1)**2)
