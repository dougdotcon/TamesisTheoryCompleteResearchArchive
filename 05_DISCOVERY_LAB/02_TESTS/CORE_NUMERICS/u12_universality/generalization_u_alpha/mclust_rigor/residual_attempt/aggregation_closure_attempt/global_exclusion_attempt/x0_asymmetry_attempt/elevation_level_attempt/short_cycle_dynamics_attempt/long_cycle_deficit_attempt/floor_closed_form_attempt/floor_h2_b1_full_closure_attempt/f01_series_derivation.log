======================================================================
PART C -- numeric recursion for a2(0), a3(0) at c=1000, and the
           resulting truncated series for Phi(0,t0)
======================================================================

a0 = 1.0
a1 = -1000.0
b1(0) = psi1(0) = sqrt(pi*c/2) = 39.633273
a2(0) = (c/2)(c+1+psi1(0)) = 520316.636488

b2(0) (one numerical quadrature; quad abs-err est 1.84e-08) = -20816.63648803
a2'(0) = -519816.636488
w2(0)  = a1/2 + b2(0) - psi1(0) = -21356.269761
a3(0) = [a2'(0) - c*a2(0) + c*w2(0)] / 3 = -180730907.628508

