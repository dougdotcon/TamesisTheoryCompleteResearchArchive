  Y=         5: quad-based h=0.966666666667  closed-form h=0.966666666667  |diff|=1.336e-51  gap-to-L=3.333e-01
  Y=        10: quad-based h=1.118181818182  closed-form h=1.118181818182  |diff|=0.000e+00  gap-to-L=1.818e-01
  Y=       100: quad-based h=1.280198019802  closed-form h=1.280198019802  |diff|=0.000e+00  gap-to-L=1.980e-02
  Y=      1000: quad-based h=1.298001998002  closed-form h=1.298001998002  |diff|=0.000e+00  gap-to-L=1.998e-03
