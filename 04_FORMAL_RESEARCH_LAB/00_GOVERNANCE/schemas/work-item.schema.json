{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tamesis-work-item/1",
  "type": "object",
  "required": [
    "work_item_id",
    "title",
    "track",
    "target_statement",
    "expected_product",
    "dependencies",
    "stop_condition",
    "priority_class",
    "status",
    "authorized_next_gate"
  ],
  "properties": {
    "work_item_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "title": {"type": "string", "minLength": 1},
    "track": {"type": "string", "minLength": 1},
    "target_statement": {"type": "string", "minLength": 1},
    "expected_product": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "existing_assets": {"type": "array", "items": {"type": "string"}},
    "formalization_cost": {"type": "string"},
    "bibliographic_cost": {"type": "string"},
    "counterexample_access": {"type": "string"},
    "dependency_depth": {"type": "integer", "minimum": 0},
    "external_dependency": {"type": "string"},
    "cross_track_value": {"type": "string"},
    "stop_condition": {"type": "string", "minLength": 1},
    "priority_class": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "authorized_next_gate": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
